{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airan.local/schemas/pusch-grant-v1.json",
  "title": "AI-RAN dynamic PUSCH grant",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "grant_name", "slot_number", "rank", "transport", "waveform", "dmrs", "precoding", "loopback_channel"],
  "properties": {
    "schema_version": {"const": 1},
    "grant_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "slot_number": {"type": "integer", "minimum": 0, "maximum": 1023},
    "rank": {"type": "integer", "minimum": 1, "maximum": 4},
    "transport": {
      "type": "object", "additionalProperties": false,
      "required": ["rnti", "data_scrambling_id", "codeword_index"],
      "properties": {
        "rnti": {"type": "integer", "minimum": 1, "maximum": 65535},
        "data_scrambling_id": {"type": "integer", "minimum": 0, "maximum": 1023},
        "codeword_index": {"type": "integer", "minimum": 0, "maximum": 1}
      }
    },
    "waveform": {
      "type": "object", "additionalProperties": false,
      "required": ["qm", "num_symbols", "start_symbol", "fft_size", "num_rb", "rb_start", "used_subcarriers", "padded_subcarriers", "data_re_alignment", "qam_row_alignment"],
      "properties": {
        "qm": {"enum": [2, 4, 6, 8]},
        "num_symbols": {"type": "integer", "minimum": 1, "maximum": 14},
        "start_symbol": {"type": "integer", "minimum": 0, "maximum": 13},
        "fft_size": {"type": "integer", "minimum": 128, "maximum": 4096},
        "num_rb": {"type": "integer", "minimum": 1, "maximum": 275},
        "rb_start": {"type": "integer", "minimum": 0, "maximum": 274},
        "used_subcarriers": {"type": "integer", "minimum": 1, "maximum": 3300},
        "padded_subcarriers": {"type": "integer", "minimum": 1, "maximum": 4096},
        "data_re_alignment": {"type": "integer", "minimum": 1, "maximum": 4096},
        "qam_row_alignment": {"type": "integer", "minimum": 1, "maximum": 4096}
      }
    },
    "dmrs": {
      "type": "object", "additionalProperties": false,
      "required": ["symbols", "ports", "scrambling_id", "type", "length", "additional_position", "mapping_type", "num_cdm_groups_without_data", "n_scid"],
      "properties": {
        "symbols": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 13}},
        "ports": {"oneOf": [{"const": "auto"}, {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "integer", "minimum": 1000, "maximum": 1011}}]},
        "scrambling_id": {"type": "integer", "minimum": 0, "maximum": 65535},
        "type": {"enum": [1, 2]},
        "length": {"enum": [1, 2]},
        "additional_position": {"type": "integer", "minimum": 0, "maximum": 3},
        "mapping_type": {"enum": [0, 1]},
        "num_cdm_groups_without_data": {"type": "integer", "minimum": 1, "maximum": 3},
        "n_scid": {"enum": [0, 1]}
      }
    },
    "precoding": {
      "type": "object", "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["auto", "bypass", "codebook", "non_codebook"]},
        "tpmi": {"type": "integer", "minimum": 0, "maximum": 65535},
        "prg_size_rb": {"type": "integer", "minimum": 1, "maximum": 275}
      }
    },
    "loopback_channel": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "gain", "awgn_std_int16"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "gain": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "awgn_std_int16": {"type": "number", "minimum": 0, "maximum": 200}
      }
    }
  }
}
