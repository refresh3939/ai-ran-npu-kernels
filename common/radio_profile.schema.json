{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airan.local/schemas/radio-profile-v1.json",
  "title": "AI-RAN static radio profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "radio_name", "topology", "capabilities", "receiver"],
  "properties": {
    "schema_version": {"const": 1},
    "radio_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "topology": {
      "type": "object", "additionalProperties": false,
      "required": ["architecture", "tx_antennas", "tx_rf_chains", "rx_antennas", "rx_rf_chains"],
      "properties": {
        "architecture": {"enum": ["full_digital", "hybrid", "analog"]},
        "tx_antennas": {"type": "integer", "minimum": 1, "maximum": 16},
        "tx_rf_chains": {"type": "integer", "minimum": 1, "maximum": 16},
        "rx_antennas": {"type": "integer", "minimum": 1, "maximum": 64},
        "rx_rf_chains": {"type": "integer", "minimum": 1, "maximum": 64}
      }
    },
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["supported_ranks", "pusch_port_policy", "antenna_mapping"],
      "properties": {
        "supported_ranks": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 4}},
        "pusch_port_policy": {"const": "nr_4port"},
        "antenna_mapping": {"enum": ["identity", "semi_unitary_dft"]}
      }
    },
    "receiver": {
      "type": "object", "additionalProperties": false,
      "required": ["channel_estimator", "detector", "max_rx_antennas", "rx_buckets", "storage_layers", "rx_capacity_adapter"],
      "properties": {
        "channel_estimator": {"type": "string", "minLength": 1},
        "detector": {"type": "string", "minLength": 1},
        "max_rx_antennas": {"type": "integer", "minimum": 1, "maximum": 64},
        "rx_buckets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 64}},
        "storage_layers": {"const": 16},
        "rx_capacity_adapter": {"type": "string", "minLength": 1}
      }
    }
  }
}
